# tools/shopify/.env.local — yours alone, git-ignored. Copy this file there and fill it in:
#   cp tools/shopify/.env.example tools/shopify/.env.local
# theme.sh reads it (and, after Stage 0, the video toolkit). The process environment wins over it.

# Your own demo dev store (the briefs call them dev store A — Yeasir's — and dev store B — Asad's).
SHOPIFY_STORE=your-demo-store.myshopify.com

# That store's storefront password (Online Store → Preferences → Password protection).
# The capture toolkit enters it before recording; it is never on screen and never in a script.
SHOPIFY_STOREFRONT_PASSWORD=

# Optional: a Theme Access app password, so the CLI works without the browser login.
# SHOPIFY_CLI_THEME_TOKEN=

# Optional: a classic-accounts test customer the capture toolkit signs in when a clip needs one.
# PERVEJ_CAPTURE_USER=
# PERVEJ_CAPTURE_PASS=

# Optional overrides
# SHOPIFY_CLI=shopify
# DAWN_REF=v16.0.0
# HORIZON_REF=HEAD
