# Theme code follows Dawn/Horizon: 2 spaces, LF, final newline.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

# The video toolkit was written with tabs; keep it consistent.
[tools/video/**.{mjs,js,css,html}]
indent_style = tab

[*.md]
trim_trailing_whitespace = false

[*.txt]
trim_trailing_whitespace = false
